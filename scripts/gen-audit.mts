// Generates docs/CONTENT_AUDIT_V2.md: every lesson, which standard sections it has, its verified code samples, visuals, tables,
// practice/quiz counts, and the gaps still to close for the V2 visual upgrade. Run: npx tsx scripts/gen-audit.mts
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { Topic, allSamples } from "../lib/content-schema";
import { CHAPTERS } from "../lib/course";

const INTERACTIVE = new Set(["array", "sort", "pattern", "matrix", "resolver", "recursion", "memory", "canvas", "decision", "switch", "truth", "match"]);
const rows: string[] = [];
const gapRows: string[] = [];
let n = 0, samples = 0, traced = 0, noVisual = 0, noInteractive = 0, noTable = 0;
const perWeek: string[] = [];

for (const c of CHAPTERS) {
  const dir = join("content", `week-${String(c.week).padStart(2, "0")}`);
  const topics = readdirSync(dir).filter((f) => f.endsWith(".json")).map((f) => Topic.parse(JSON.parse(readFileSync(join(dir, f), "utf8")))).sort((a, b) => a.order - b.order);
  perWeek.push(`| ${c.week} | ${c.title} | ${topics.length} |`);
  for (const t of topics) {
    n++;
    const s = allSamples(t), tr = s.filter((x) => x.trace).length;
    samples += s.length; traced += tr;
    const kinds = [...new Set(t.visuals.map((v) => v.kind))];
    const hasVisual = kinds.some((k) => k !== "trace") || tr > 0;
    const hasInteractive = kinds.some((k) => INTERACTIVE.has(k)) || tr > 0;
    const hasTable = t.variations.length > 0;
    const gaps: string[] = [];
    if (!hasVisual) { gaps.push("no animation/diagram"); noVisual++; }
    if (!hasInteractive) { gaps.push("no interactive element"); noInteractive++; }
    if (!hasTable) { gaps.push("no comparison table"); noTable++; }
    if (t.practice.length < 6) gaps.push(`practice ${t.practice.length}<6`);
    if (t.quiz.length < 3) gaps.push(`quiz ${t.quiz.length}<3`);
    if (t.worked.length !== 3) gaps.push(`worked ${t.worked.length}!=3`);
    const sections = [t.goal && "goal", t.warmup && "warm-up", t.definition && "definition", t.howItWorks && "how", t.syntax && "syntax", t.worked.length && "worked", t.variations.length && "table", t.mistakes.length && "mistakes", t.examTips.length && "tips", t.romanSummary.length && "roman"].filter(Boolean).length;
    rows.push(`| ${t.week}/${t.slug} | ${sections}/10 | ${s.length}${s.some((x) => x.graphics) ? " (graphics)" : ""} | ${tr} | ${kinds.join(", ") || "-"} | ${t.variations.length} | ${t.practice.length} | ${t.quiz.length} | ${gaps.join("; ") || "-"} |`);
    if (gaps.length) gapRows.push(`- \`${t.week}/${t.slug}\`: ${gaps.join("; ")}`);
  }
}

const out = [
  "# CONTENT AUDIT (V2)",
  "",
  "Generated by `npx tsx scripts/gen-audit.mts` from the lesson files. Code samples: every one is compiled and run with g++ by `npm run verify:content` (graphics.h samples are type-checked against a stub header and drawn by the simulator), and `tests/coverage-claims.test.ts` guards the lesson format.",
  "",
  `**${n} lessons, ${samples} verified code samples, ${traced} hand-authored step traces checked against real output.**`,
  "",
  "## Lessons per week",
  "| Week | Chapter | Lessons |", "|---|---|---|", ...perWeek, "",
  "## Every lesson",
  "| Lesson | Sections | Samples | Traces | Visual kinds | Table rows | Practice | Quiz | Gaps vs V2 standard |", "|---|---|---|---|---|---|---|---|---|", ...rows, "",
  "## Gaps against the V2 lesson standard (picture first, one table, one interactive element)",
  `Lessons without an animation or diagram: **${noVisual}**; without an interactive element: **${noInteractive}**; without a comparison table: **${noTable}**.`,
  "",
  ...(gapRows.length ? gapRows : ["None."]),
  "",
  "Interactive here means a stepper, slider, match activity, array/sort/matrix/memory/recursion/canvas visual or a step trace. Static pipeline diagrams and flowcharts do not count.",
];
writeFileSync("docs/CONTENT_AUDIT_V2.md", out.join("\n"));
console.log(`audit: ${n} lessons; no visual ${noVisual}; no interactive ${noInteractive}; no table ${noTable}`);
