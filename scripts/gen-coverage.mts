// Regenerates the lesson table in docs/CONTENT_COVERAGE.md from the lessons' own `sources` (outline topics) fields.
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { Topic } from "../lib/content-schema";
import { CHAPTERS } from "../lib/course";

const lines: string[] = [
  "# CONTENT COVERAGE (outline topic -> lesson)",
  "",
  "Generated by `npx tsx scripts/gen-coverage.mts` from each lesson's `sources` field (the official outline topics it teaches).",
  "The order of weeks and topics follows the official OBE outline; Weeks 3-16 follow the instructor notes' section headings (3.x-16.x), which mirror the outline.",
  "",
];
let total = 0;
for (const c of CHAPTERS) {
  const dir = join("content", `week-${String(c.week).padStart(2, "0")}`);
  let files: string[] = [];
  try { files = readdirSync(dir).filter((f) => f.endsWith(".json")); } catch { /* none */ }
  const topics = files.map((f) => Topic.parse(JSON.parse(readFileSync(join(dir, f), "utf8")))).sort((a, b) => a.order - b.order);
  total += topics.length;
  lines.push(`## Week ${c.week}: ${c.title} (${topics.length} lessons)`, "", "| Lesson | Outline topics covered |", "|---|---|");
  for (const t of topics) lines.push(`| \`${t.slug}\` ${t.title} | ${t.sources.join("; ") || "-"} |`);
  lines.push("");
}
lines.splice(5, 0, `**${total} lessons across all 16 weeks.**`, "");
writeFileSync("docs/CONTENT_COVERAGE.md", lines.join("\n"));
console.log(`wrote docs/CONTENT_COVERAGE.md (${total} lessons)`);
